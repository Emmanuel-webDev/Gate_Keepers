# Helius RPC API Key (devnet/mainnet)
HELIUS_API_KEY=

# Deployed Anchor program ID
PROGRAM_ID=G65C3XsAhvJkYiE4GEcY5jJuabsWVDL2dXJ1D8wbY3ST

# Backend payer wallet (choose either KEYPAIR_PATH or KEYPAIR_JSON):
# 1. Path to keypair file:
KEYPAIR_PATH=id.json
# 2. Or inline raw JSON byte array for cloud hosts (Railway, Render, Fly.io, etc.):
# KEYPAIR_JSON=[1,2,3,...]

# Directory for persisted state and checkins (optional, defaults to ./data):
# DATA_DIR=./data

# Public base URL of backend (used for ticket metadata URIs fetched by Solana/Helius DAS)
PUBLIC_URL=http://localhost:8787

# Server port (defaults to 8787)
PORT=8787

# Node environment
NODE_ENV=production
